# ==============================================================================
# PS-05: Digital Evidence Authenticity & Integrity Verification Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# Core Application Settings
PS05_ENV=development
PS05_DEBUG=true
PS05_HOST=127.0.0.1
PS05_PORT=8000
PS05_SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-key

# Storage & WORM Vault Configuration
PS05_STORAGE_BACKEND=posix_worm
PS05_WORM_ROOT_DIR=./data/vault_worm
PS05_DERIVED_ARTIFACTS_DIR=./data/derived_cache
# S3 / MinIO Settings (if PS05_STORAGE_BACKEND=s3)
PS05_S3_ENDPOINT=http://127.0.0.1:9000
PS05_S3_ACCESS_KEY=minioadmin
PS05_S3_SECRET_KEY=minioadmin
PS05_S3_BUCKET_EVIDENCE=evidence-worm
PS05_S3_BUCKET_ARTIFACTS=derived-artifacts

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql+asyncpg://ps05_user:ps05_password@127.0.0.1:5432/ps05_forensics
DATABASE_ECHO=false

# Asynchronous Task Queue (Redis + Celery)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_CONCURRENCY=4

# ML Runtime & Device Acceleration
PS05_DEVICE=cuda
PS05_FALLBACK_TO_CPU=true
PS05_MODELS_CACHE_DIR=./models/checkpoints

# External Tool Binaries (Ensure in PATH or specify absolute paths)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
EXIFTOOL_BINARY=exiftool
TESSERACT_BINARY=tesseract

# Forensic Reporting & Legal Compliance
LEGAL_JURISDICTION=INDIA_BSA_2023
DEFAULT_CERTIFICATE_TYPE=SECTION_63_BSA
DIGITAL_SIGNATURE_KEY_PATH=./config/certs/examiner_dummy.pem
